{
  "cli_default_open_behavior": "new_window",
  "indent_guides": {
    "coloring": "indent_aware"
  },
  "tab_size": 2,
  "vim": {
    "cursor_shape": {
      "visual": "underline",
      "insert": "bar"
    },
    "highlight_on_yank_duration": 500,
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },
  "relative_line_numbers": "enabled",
  "drag_and_drop_selection": {
    "delay": 400
  },
  "hover_popover_hiding_delay": 400,
  "hover_popover_delay": 400,
  "horizontal_scroll_margin": 3.0,
  "which_key": {
    "delay_ms": 1000,
    "enabled": true
  },
  "minimum_contrast_for_highlights": 50.0,
  "rounded_selection": false,
  "cursor_shape": "block",
  "cursor_blink": false,
  "ui_font_weight": 500.0,
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 500.0,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "vim_mode": true,
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "theme": "Catppuccin Mocha - No Italics", // Plugin
  "icon_theme": "Catppuccin Mocha", // Plugin
}
